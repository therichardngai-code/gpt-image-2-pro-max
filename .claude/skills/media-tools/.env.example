# media-tools .env — copy to `.env` (same dir) and fill in the keys you have.
# Loaded automatically by create_image.py / read_image.py at startup.
# Existing OS env vars take precedence (we use os.environ.setdefault).
#
# Loader search order (first existing wins):
#   1. $MEDIA_TOOLS_ENV  (explicit override path)
#   2. .claude/skills/media-tools/.env   <-- this file's location
#   3. ~/.config/media-tools/.env  (POSIX) | %APPDATA%\media-tools\.env (Windows)

# --- Image-generation providers (chain order: openrouter → gemini → openai → minimax → dashscope → byteplus) ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
BYTEPLUS_API_KEY=

# --- Vision providers (chain order: openrouter → gemini → anthropic → dashscope) ---
ANTHROPIC_API_KEY=

# --- Optional API base overrides (skip unless using a proxy / self-hosted gateway) ---
# OPENROUTER_API_BASE=
# OPENAI_API_BASE=
# GEMINI_API_BASE=
# ANTHROPIC_API_BASE=
# MINIMAX_API_BASE=
# DASHSCOPE_API_BASE=
# BYTEPLUS_API_BASE=

# --- Output workspace (where generated images land) ---
# WEB_TOOLS_WORKSPACE=C:\path\to\workspace

# Note: chatgpt_oauth provider does NOT use env keys — it reads ~/.codex/auth.json
# (run scripts/chatgpt_oauth_login.py to set up if you don't have Codex installed).
